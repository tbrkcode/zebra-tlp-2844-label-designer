<Window x:Class="EtiketStudio.Windows.Views.PreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="clr-namespace:EtiketStudio.Windows.Infrastructure" Title="{i:Text Preview}" Width="1000" Height="760" MinWidth="700" MinHeight="540" WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock x:Name="Summary" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{i:Text PreviewHelp}" Margin="0,6,0,8" TextWrapping="Wrap"/></StackPanel>
  <StackPanel Grid.Row="1">
   <Grid x:Name="ProductPanel"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Label Content="{i:Text Name}"/><ComboBox x:Name="ProductPicker" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="Product_Changed"/></Grid>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Label Content="{i:Text Printer}"/><ComboBox x:Name="PrinterPicker" Grid.Column="1" DisplayMemberPath="Display" SelectionChanged="Printer_Changed"/><Button x:Name="RefreshButton" Grid.Column="2" Content="{i:Text RefreshPrinters}" Click="Refresh_Click"/></Grid>
   <CheckBox x:Name="DriverModeCheck" Content="{i:Text DriverMode}" Checked="Mode_Changed" Unchecked="Mode_Changed"/>
   <TextBlock x:Name="DriverHelp" Text="{i:Text DriverCancelHelp}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
   <TextBlock x:Name="PrinterHint" TextWrapping="Wrap" Margin="0,4,0,0"/>
   <TextBlock x:Name="RenderError" TextWrapping="Wrap" Margin="0,4,0,4" FontWeight="SemiBold"/>
  </StackPanel>
  <DockPanel Grid.Row="2" Margin="0,6,0,8"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="PreviousButton" Content="{i:Text Previous}" Click="Previous_Click"/><Button x:Name="NextButton" Content="{i:Text Next}" Click="Next_Click"/><Button Content="{i:Text ActualSize}" Click="Actual_Click"/></StackPanel><TextBlock x:Name="ItemName" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
  <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><StackPanel HorizontalAlignment="Center" Margin="20"><Border BorderBrush="#A0AAB5" BorderThickness="1"><Image x:Name="PreviewImage" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Border><Border x:Name="Ruler" Height="15" BorderBrush="{DynamicResource ForegroundBrush}" BorderThickness="1,0,1,1" HorizontalAlignment="Left" Margin="0,16,0,2"/><TextBlock Text="50 mm" FontSize="11"/></StackPanel></ScrollViewer>
  <WrapPanel Grid.Row="4" Margin="0,12,0,0" HorizontalAlignment="Right"><Button x:Name="EplButton" Content="{i:Text EplExport}" Click="Epl_Click"/><Button x:Name="PngButton" Content="{i:Text PngExport}" Click="Png_Click"/><Button Content="{i:Text Cancel}" Click="Cancel_Click"/><Button x:Name="PrintButton" Content="{i:Text Print}" Style="{StaticResource PrimaryButton}" Click="Print_Click"/></WrapPanel>
 </Grid>
</Window>
