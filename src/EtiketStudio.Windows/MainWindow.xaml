<?xml version="1.0" ?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="clr-namespace:EtiketStudio.Windows.Infrastructure" xmlns:v="clr-namespace:EtiketStudio.Windows.Views" x:Class="EtiketStudio.Windows.MainWindow" Title="TBRK Label Studio 0.1.3" Width="1400" Height="900" MinWidth="800" MinHeight="520" WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}">
  <Window.Resources>
    <i:ImageBytesConverter x:Key="ImageBytes"/>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#C0CFDF"/>
      <Setter Property="Margin" Value="8,3"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabBackground" Padding="16,13" CornerRadius="7">
              <TextBlock Text="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabBackground" Property="Background" Value="#285650"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabBackground" Property="Opacity" Value="0.75"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Window.InputBindings>
    <KeyBinding Key="Z" Modifiers="Control" Command="{Binding Undo}"/>
    <KeyBinding Key="Y" Modifiers="Control" Command="{Binding Redo}"/>
  </Window.InputBindings>
  <ScrollViewer x:Name="WindowScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
  <DockPanel MinWidth="1120" MinHeight="720" Width="{Binding ViewportWidth, ElementName=WindowScroller}" Height="{Binding ViewportHeight, ElementName=WindowScroller}">
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="15,7">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{i:Text WindowsQueue}" Command="{Binding OpenWindowsQueue}" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}"/>
        <Button DockPanel.Dock="Right" Content="{i:Text StopSubmission}" Command="{Binding CancelSubmission}" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}"/>
        <ProgressBar DockPanel.Dock="Right" Width="90" Height="5" IsIndeterminate="True" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" Margin="12,0"/>
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </DockPanel>
    </Border>
    <TabControl TabStripPlacement="Left" SelectedIndex="1" IsEnabled="{Binding Busy, Converter={StaticResource InverseBool}}" BorderThickness="0" Background="{DynamicResource BackgroundBrush}">
      <TabControl.Template>
        <ControlTemplate TargetType="TabControl">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="190"/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Background="#152333">
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="22,30,12,30">
                  <TextBlock Text="TBRK" Foreground="White" FontSize="27" FontWeight="Bold"/>
                  <TextBlock Text="LABEL STUDIO" Foreground="#6ED4BE" FontSize="15" FontWeight="SemiBold" Margin="1,3,0,0"/>
                  <TextBlock Text="TLP 2844 · EPL2" Foreground="#90A9BD" FontSize="11" Margin="0,16,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="18,16">
                  <TextBlock Text="{i:Text Offline}" Foreground="#90A9BD" FontSize="10" TextWrapping="Wrap"/>
                  <TextBlock Text="v0.1.3" Foreground="#90A9BD" FontSize="10" Margin="0,8,0,0"/>
                </StackPanel>
                <TabPanel IsItemsHost="True" VerticalAlignment="Top"/>
              </DockPanel>
            </Border>
            <ContentPresenter Grid.Column="1" ContentSource="SelectedContent"/>
          </Grid>
        </ControlTemplate>
      </TabControl.Template>
      <TabItem Header="{i:Text Products}">
        <Grid Margin="22">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <TextBlock Text="{i:Text Products}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18"/>
          <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
              <Button Content="{i:Text Import}" Command="{Binding ImportProducts}"/>
              <Button Content="{i:Text Export}" Command="{Binding ExportProducts}"/>
            </StackPanel>
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="300" HorizontalAlignment="Left" ToolTip="{i:Text Search}"/>
          </DockPanel>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="18"/>
              <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding ProductView}" SelectedItem="{Binding SelectedProduct}" IsReadOnly="True" SelectionMode="Single">
              <DataGrid.Columns>
                <DataGridTextColumn Header="{i:Text Name}" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="{i:Text Sku}" Binding="{Binding Sku}" Width="100"/>
                <DataGridTextColumn Header="{i:Text Barcode}" Binding="{Binding Barcode}" Width="130"/>
                <DataGridTextColumn Header="{i:Text Price}" Binding="{Binding Price, StringFormat=N2}" Width="85"/>
              </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2" Style="{StaticResource Card}">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <WrapPanel>
                    <Button Content="{i:Text New}" Command="{Binding NewProduct}"/>
                    <Button Content="{i:Text Save}" Command="{Binding SaveProduct}" Style="{StaticResource PrimaryButton}"/>
                    <Button Content="{i:Text Delete}" Command="{Binding DeleteProduct}"/>
                  </WrapPanel>
                  <Label Content="{i:Text Name}"/>
                  <TextBox Text="{Binding EditProduct.Name, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
                  <Label Content="{i:Text Sku}"/>
                  <TextBox Text="{Binding EditProduct.Sku, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
                  <Label Content="{i:Text Barcode}"/>
                  <TextBox Text="{Binding EditProduct.Barcode, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
                  <Label Content="{i:Text Price}"/>
                  <TextBox Text="{Binding EditProduct.Price, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
                  <Label Content="{i:Text Category}"/>
                  <TextBox Text="{Binding EditProduct.Category, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
                  <Label Content="{i:Text Description}"/>
                  <TextBox Text="{Binding EditProduct.Description, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" AcceptsReturn="True" TextWrapping="Wrap" Height="70"/>
                  <Image Source="{Binding EditProduct.Image, Converter={StaticResource ImageBytes}}" Height="90" Margin="0,12" Stretch="Uniform"/>
                  <WrapPanel>
                    <Button Content="{i:Text Browse}" Command="{Binding ProductImage}"/>
                    <Button Content="{i:Text RemoveImage}" Command="{Binding RemoveProductImage}"/>
                  </WrapPanel>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="{i:Text Designer}">
        <Grid Margin="22">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <DockPanel>
            <TextBlock Text="{i:Text Designer}" FontSize="24" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="{i:Text New}" Command="{Binding NewTemplate}"/>
              <Button Content="{i:Text Open}" Command="{Binding OpenTemplate}"/>
              <Button Content="{i:Text Save}" Command="{Binding SaveTemplate}"/>
              <Button Content="{i:Text Undo}" Command="{Binding Undo}"/>
              <Button Content="{i:Text Redo}" Command="{Binding Redo}"/>
              <Button Content="{i:Text Preview}" Command="{Binding PreviewSingle}" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
          </DockPanel>
          <WrapPanel Grid.Row="1" Margin="0,8,0,12">
            <StackPanel Width="180" Margin="0,0,12,0">
              <Label Content="{i:Text TemplateName}"/>
              <TextBox Text="{Binding Template.Name, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
            </StackPanel>
            <StackPanel Width="115" Margin="0,0,12,0">
              <Label Content="{i:Text Width}"/>
              <TextBox Text="{Binding Template.Width, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
            </StackPanel>
            <StackPanel Width="115" Margin="0,0,12,0">
              <Label Content="{i:Text Height}"/>
              <TextBox Text="{Binding Template.Height, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
            </StackPanel>
            <StackPanel Width="115" Margin="0,0,12,0">
              <Label Content="{i:Text Gap}"/>
              <TextBox Text="{Binding Template.Gap, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
            </StackPanel>
            <StackPanel Width="210" Margin="0,0,12,0">
              <Label Content="{i:Text ProductName}"/>
              <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" DisplayMemberPath="Name"/>
            </StackPanel>
            <StackPanel Width="65">
              <Label Content="{i:Text Copies}"/>
              <TextBox Text="{Binding Copies, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
            </StackPanel>
          </WrapPanel>
          <TextBlock Grid.Row="2" Text="{i:Text EditorHelp}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
          <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130"/>
              <ColumnDefinition/>
              <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="9">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{i:Text AddObject}" FontWeight="SemiBold" Margin="5,6,0,12"/>
                <ListBox x:Name="Toolbox" ItemsSource="{Binding ElementKinds}" ItemTemplate="{StaticResource EnumTemplate}" PreviewMouseLeftButtonDown="Toolbox_Down" PreviewMouseMove="Toolbox_Move" MouseDoubleClick="Toolbox_DoubleClick">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="Padding" Value="8,10"/>
                      <Setter Property="Cursor" Value="Hand"/>
                    </Style>
                  </ListBox.ItemContainerStyle>
                </ListBox>
              </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="12,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
              </Grid.RowDefinitions>
              <WrapPanel Margin="0,0,0,12">
                <TextBlock Text="{i:Text Zoom}" VerticalAlignment="Center"/>
                <Slider Value="{Binding Zoom}" Minimum="0.5" Maximum="5" Width="90" Margin="8,0" VerticalAlignment="Center"/>
                <Button Content="{i:Text ActualSize}" Command="{Binding ActualSize}"/>
                <CheckBox Content="{i:Text Snap}" IsChecked="{Binding Snap}"/>
              </WrapPanel>
              <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <v:LabelCanvas Margin="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </ScrollViewer>
            </Grid>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="15">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Text="{i:Text Properties}" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock Text="{i:Text ChooseObject}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,6"/>
                  <TextBlock FontWeight="SemiBold" Margin="0,8"><TextBlock.Text><MultiBinding Converter="{StaticResource EnumName}"><Binding Path="SelectedElement.Kind"/><Binding Path="Revision" Source="{x:Static i:UiLanguage.Source}"/></MultiBinding></TextBlock.Text></TextBlock>
                  <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,7,0">
                      <Label Content="{i:Text X}"/>
                      <TextBox Text="{Binding SelectedElement.X, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,7,0">
                      <Label Content="{i:Text Y}"/>
                      <TextBox Text="{Binding SelectedElement.Y, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,7,0">
                      <Label Content="{i:Text Width}"/>
                      <TextBox Text="{Binding SelectedElement.Width, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,7,0">
                      <Label Content="{i:Text Height}"/>
                      <TextBox Text="{Binding SelectedElement.Height, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
                    </StackPanel>
                  </UniformGrid>
                  <Label Content="{i:Text Content}"/>
                  <TextBox Text="{Binding SelectedElement.Text, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" AcceptsReturn="True" TextWrapping="Wrap" Height="60"/>
                  <Label Content="{i:Text BarcodeType}"/>
                  <ComboBox ItemsSource="{Binding BarcodeKinds}" SelectedItem="{Binding SelectedElement.BarcodeKind}" ItemTemplate="{StaticResource EnumTemplate}"/>
                  <Label Content="{i:Text FontFamily}"/>
                  <TextBox Text="{Binding SelectedElement.FontFamily, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
                  <Label Content="{i:Text FontSize}"/>
                  <TextBox Text="{Binding SelectedElement.FontSize, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
                  <Label Content="{i:Text Stroke}"/>
                  <TextBox Text="{Binding SelectedElement.Stroke, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
                  <CheckBox Content="{i:Text Bold}" IsChecked="{Binding SelectedElement.Bold}"/>
                  <CheckBox Content="{i:Text HumanReadable}" IsChecked="{Binding SelectedElement.HumanReadable}"/>
                  <Button Content="{i:Text Browse}" Command="{Binding AttachImage}"/>
                  <WrapPanel>
                    <Button Content="{i:Text Duplicate}" Command="{Binding DuplicateElement}"/>
                    <Button Content="{i:Text Delete}" Command="{Binding DeleteElement}"/>
                    <Button Content="{i:Text BringFront}" Command="{Binding BringFront}"/>
                    <Button Content="{i:Text SendBack}" Command="{Binding SendBack}"/>
                  </WrapPanel>
                  <TextBlock Text="{i:Text FieldsHelp}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,10"/>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="{i:Text PrinterSettings}">
        <Grid Margin="22">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <TextBlock Text="{i:Text PrinterSettings}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18"/>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{i:Text RefreshPrinters}" Command="{Binding RefreshPrinters}"/>
                    <ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}" DisplayMemberPath="Display" Margin="0,0,12,0"/>
                  </DockPanel>
                  <TextBlock Text="{Binding SelectedPrinter.Driver}" Foreground="{DynamicResource MutedBrush}" Margin="0,8"/>
                  <TextBlock Text="{i:Text RawModeHelp}" TextWrapping="Wrap" Margin="0,8"/>
                  <WrapPanel>
                    <StackPanel Width="210" Margin="0,0,18,0">
                      <Label Content="{i:Text Darkness}"/>
                      <TextBox Text="{Binding Settings.Darkness, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
                    </StackPanel>
                    <StackPanel Width="210">
                      <Label Content="{i:Text Speed}"/>
                      <ComboBox ItemsSource="{Binding Speeds}" SelectedItem="{Binding Settings.Speed}"/>
                    </StackPanel>
                  </WrapPanel>
                  <TextBlock Text="{i:Text SpeedHelp}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8"/>
                  <WrapPanel>
                    <CheckBox Content="{i:Text DirectThermal}" IsChecked="{Binding Settings.DirectThermal}"/>
                    <CheckBox Content="{i:Text Reverse}" IsChecked="{Binding Settings.Reverse}"/>
                    <CheckBox Content="{i:Text DriverMode}" IsChecked="{Binding Settings.DriverMode}"/>
                  </WrapPanel>
                  <TextBlock Text="{i:Text DriverHelp}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,15"/>
                  <WrapPanel>
                    <Button Content="{i:Text SaveSettings}" Command="{Binding SaveSettings}" Style="{StaticResource PrimaryButton}"/>
                    <Button Content="{i:Text Calibration}" Command="{Binding Calibrate}"/>
                    <Button Content="{i:Text NativeTest}" Command="{Binding NativeTest}"/>
                    <Button Content="{i:Text ConfigPrint}" Command="{Binding ConfigurationTest}"/>
                    <Button Content="{i:Text WindowsQueue}" Command="{Binding OpenWindowsQueue}"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
              <DockPanel Margin="0,22,0,6">
                <TextBlock Text="{i:Text WindowsQueue}" FontSize="19" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Content="{i:Text RefreshQueue}" Command="{Binding RefreshQueue}"/>
                  <Button Content="{i:Text CancelJob}" Command="{Binding CancelJob}"/>
                </StackPanel>
              </DockPanel>
              <TextBlock Text="{i:Text QueueHelp}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
              <DataGrid ItemsSource="{Binding Queue}" SelectedItem="{Binding SelectedJob}" IsReadOnly="True" Height="170">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="{i:Text JobId}" Binding="{Binding Id}" Width="90"/>
                  <DataGridTextColumn Header="{i:Text Document}" Binding="{Binding Document}" Width="*"/>
                  <DataGridTextColumn Header="{i:Text Status}" Binding="{Binding Status}" Width="220"/>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Text="{i:Text History}" FontSize="19" FontWeight="SemiBold" Margin="0,20,0,10"/>
              <DataGrid ItemsSource="{Binding History}" IsReadOnly="True" Height="210">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="{i:Text Time}" Binding="{Binding Time, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
                  <DataGridTextColumn Header="{i:Text Printer}" Binding="{Binding Printer}" Width="*"/>
                  <DataGridTextColumn Header="{i:Text JobId}" Binding="{Binding SpoolId}" Width="65"/>
                  <DataGridTextColumn Header="{i:Text Labels}" Binding="{Binding Labels}" Width="90"/>
                  <DataGridTextColumn Header="{i:Text Status}" Binding="{Binding State}" Width="260"/>
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="{i:Text BarcodeTools}">
        <Grid Margin="22">
          <StackPanel>
            <TextBlock Text="{i:Text BarcodeTools}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18"/>
            <Border Style="{StaticResource Card}" MaxWidth="660" HorizontalAlignment="Left">
              <StackPanel Width="590">
                <Label Content="{i:Text BarcodeType}"/>
                <ComboBox ItemsSource="{Binding BarcodeKinds}" SelectedItem="{Binding ToolBarcode}" ItemTemplate="{StaticResource EnumTemplate}"/>
                <Label Content="{i:Text Content}"/>
                <TextBox Text="{Binding BarcodeInput, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
                <WrapPanel Margin="0,18,0,0">
                  <Button Content="{i:Text ValidateBarcode}" Command="{Binding ValidateBarcode}" Style="{StaticResource PrimaryButton}"/>
                  <Button Content="{i:Text UseBarcode}" Command="{Binding ApplyBarcode}"/>
                </WrapPanel>
                <TextBlock Text="{Binding BarcodeResult}" TextWrapping="Wrap" FontSize="18" Margin="0,16,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="{i:Text BatchPrint}">
        <Grid Margin="22">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <TextBlock Text="{i:Text BatchPrint}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18"/>
          <StackPanel Grid.Row="1">
            <TextBlock Text="{i:Text BatchHelp}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <WrapPanel>
              <Button Content="{i:Text SelectAll}" Command="{Binding SelectAll}"/>
              <Button Content="{i:Text ClearSelection}" Command="{Binding ClearSelection}"/>
              <Button Content="{i:Text Import}" Command="{Binding ImportProducts}"/>
              <Button Content="{i:Text Preview}" Command="{Binding PreviewBatch}" Style="{StaticResource PrimaryButton}"/>
            </WrapPanel>
          </StackPanel>
          <DataGrid Grid.Row="2" ItemsSource="{Binding Products}" Margin="0,10,0,0">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="{i:Text Selected}" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
              <DataGridTextColumn Header="{i:Text Name}" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
              <DataGridTextColumn Header="{i:Text Sku}" Binding="{Binding Sku}" IsReadOnly="True" Width="140"/>
              <DataGridTextColumn Header="{i:Text Barcode}" Binding="{Binding Barcode}" IsReadOnly="True" Width="190"/>
              <DataGridTextColumn Header="{i:Text Copies}" Binding="{Binding Copies, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="90"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
      <TabItem Header="{i:Text AppSettings}">
        <Grid Margin="22">
          <StackPanel>
            <TextBlock Text="{i:Text AppSettings}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18"/>
            <Border Style="{StaticResource Card}" MaxWidth="710" HorizontalAlignment="Left">
              <StackPanel Width="650">
                <CheckBox Content="{i:Text Theme}" IsChecked="{Binding Settings.DarkTheme}"/>
                <Label Content="{i:Text Language}"/>
                <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding Settings.Language, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{i:Text RestartLanguage}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0"/>
                <Label Content="{i:Text DisplayScale}"/>
                <TextBox Text="{Binding Settings.DisplayScale, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
                <TextBlock Text="{i:Text DisplayHelp}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,18"/>
                <WrapPanel>
                  <Button Content="{i:Text SaveSettings}" Command="{Binding SaveSettings}" Style="{StaticResource PrimaryButton}"/>
                  <Button Content="{i:Text Backup}" Command="{Binding Backup}"/>
                  <Button Content="{i:Text RestoreBackup}" Command="{Binding RestoreBackup}"/>
                  <Button Content="{i:Text OpenDataFolder}" Command="{Binding OpenDataFolder}"/>
                  <Button Content="{i:Text Help}" Command="{Binding Help}"/>
                </WrapPanel>
                <TextBlock Text="{i:Text AutoBackupHelp}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <TextBlock Text="GPL-3.0-only • C# / .NET 10 • WPF / MVVM" Margin="0,22,0,4" Foreground="{DynamicResource MutedBrush}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
  </ScrollViewer>
</Window>
